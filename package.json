{
  "name": "movie-dash",
  "version": "0.10.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.7.0",
    "axios": "^1.7.9",
    "chart.js": "^4.4.7",
    "chartjs-chart-matrix": "^3.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/server.ts\"",
    "dev:lan": "concurrently \"vite --host\" \"tsx watch server/server.ts\"",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:server": "tsc --project server/tsconfig.json",
    "server:prod": "node server/dist/server/server.js --production",
    "start": "npm run build && npm run build:server && npm run server:prod",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:server": "tsc -p server/tsconfig.json --noEmit",
    "test:server": "tsx --test server/__tests__/*.test.ts",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "description": "Movie analytics dashboard",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
