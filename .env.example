TMDB_API_KEY=your_tmdb_api_key_here

# Optional: API listen address. Defaults to 127.0.0.1 (this machine only — the API has no auth).
# Set HOST=0.0.0.0 only for a deployment that must accept external connections.
# HOST=127.0.0.1

# Optional: API listen port (whole number 1-65535). Defaults to 5000.
# PORT=5000

# Optional: set only when running behind a reverse proxy (nginx, Caddy, a PaaS router), so rate
# limiting counts each original client instead of the proxy. A hop count is safest (1 = one proxy
# in front); an Express address list (e.g. loopback) also works. "true" is rejected at startup
# (it trusts every hop, so any client could spoof its IP). Leave unset without a proxy: trusting
# X-Forwarded-For lets clients spoof their IP.
# TRUST_PROXY=1

# Optional: CORS allowlist for a frontend on another origin. Not needed for `npm start`/`server:prod`
# (same origin) or `npm run dev` (Vite proxy). Defaults to http://localhost:3000.
# CLIENT_ORIGIN=http://localhost:3000

# Production mode (serve the built app from dist/) is switched on by `npm run server:prod`'s
# --production flag, or NODE_ENV=production set in the host environment. Don't set NODE_ENV here
# for local dev: `npm run dev` would then also serve a stale dist/ on port 5000.
